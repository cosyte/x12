{
  "name": "@cosyte/x12",
  "version": "0.1.15",
  "description": "Developer-focused ASC X12 healthcare EDI parser, serializer, and builder for Node.js and TypeScript: lenient on parse, spec-clean on emit.",
  "license": "MIT",
  "author": "Cosyte <hello@cosyte.com> (https://cosyte.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cosyte/x12.git"
  },
  "homepage": "https://docs.cosyte.com/x12",
  "bugs": {
    "url": "https://github.com/cosyte/x12/issues"
  },
  "keywords": [
    "x12",
    "asc-x12",
    "edi",
    "healthcare",
    "hipaa",
    "5010",
    "835",
    "837",
    "270",
    "271",
    "276",
    "277",
    "278",
    "834",
    "820",
    "999",
    "remittance",
    "claims",
    "eligibility",
    "parser",
    "serializer",
    "builder",
    "typescript"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.34.5",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./arbitraries": {
      "import": {
        "types": "./dist/arbitraries.d.ts",
        "default": "./dist/arbitraries.mjs"
      },
      "require": {
        "types": "./dist/arbitraries.d.cts",
        "default": "./dist/arbitraries.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "arbitraries": [
        "./dist/arbitraries.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "KNOWN-LIMITATIONS.md",
    "LICENSE",
    "TRADEMARKS.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "prettier": "@cosyte/prettier-config",
  "scripts": {
    "build": "cosyte-process build",
    "changeset": "changeset",
    "typecheck": "cosyte-process typecheck",
    "lint": "cosyte-process lint",
    "lint:fix": "cosyte-process lint --fix",
    "format": "cosyte-process format",
    "format:check": "cosyte-process format --check",
    "test": "cosyte-process test",
    "test:watch": "cosyte-process test --watch",
    "test:coverage": "cosyte-process test --coverage",
    "test:perf": "vitest run --config vitest.perf.config.ts test/perf/scaling-gate.perf.ts",
    "test:perf:sets": "vitest run --config vitest.perf.config.ts test/perf/scaling-gate-sets.perf.ts",
    "bench:reading": "cosyte-bench run --suite bench/x12.bench.mjs --target dist/index.mjs",
    "bench:compare": "cosyte-bench compare --suite bench/x12.bench.mjs",
    "bench:profile": "node bench/profile.mjs",
    "bench:large": "node bench/large.mjs",
    "fuzz": "vitest run test/property",
    "test:property": "vitest run test/property --exclude \"test/property/*-fuzz.property.test.ts\"",
    "quality:check": "cosyte-ratchet check --skip mutation",
    "quality:mutation": "cosyte-ratchet check --skip coverage",
    "quality:raise": "cosyte-ratchet raise",
    "mutate": "cosyte-mutate",
    "mutate:full": "cosyte-mutate full",
    "examples": "tsx scripts/run-examples.ts",
    "typecheck:examples": "tsc -p examples/tsconfig.json",
    "lint:examples": "node scripts/process-tool.mjs eslint examples --max-warnings=0",
    "phi-scan:examples": "tsx scripts/phi-scan.ts examples/*.ts examples/data/*",
    "clean": "rm -rf dist coverage *.tsbuildinfo",
    "differential": "tsx scripts/differential.ts --oracle pyx12==4.0.0 --oracle linuxforhealth-x12==0.57.0 --with pydantic==1.10.13 --with python-dotenv==1.2.3 --with typing-extensions==4.16.0 --python 3.11.16",
    "differential:check": "tsx scripts/differential.ts --check",
    "phi-scan": "tsx scripts/phi-scan.ts",
    "check:no-emdash": "cosyte-no-emdash",
    "check:no-internal-refs": "cosyte-internal-refs",
    "check:readme": "cosyte-readme",
    "check:claude-card": "cosyte-claude-card",
    "check:catalog": "cosyte-catalog",
    "check:documents": "pnpm check:readme && pnpm check:claude-card && pnpm check:catalog",
    "check:process": "cosyte-process check",
    "check:docs-reference": "cosyte-docs-reference --check",
    "docs:reference": "cosyte-docs-reference",
    "check:version-bump": "tsx scripts/check-version-bump.ts",
    "check:release-caller-permissions": "tsx scripts/check-release-caller-permissions.ts",
    "refresh:code-lists": "tsx scripts/refresh-code-lists.ts",
    "capture:271-goldens": "tsx scripts/capture-271-goldens.ts",
    "verify:exports": "node scripts/verify-exports.mjs && node scripts/verify-exports.cjs",
    "pack:docs": "cosyte-process pack-docs",
    "attw": "cosyte-attw",
    "version": "changeset version && cosyte-process sync-version && tsx scripts/sync-readme-version.ts && cosyte-process format && cosyte-docs-reference",
    "release": "changeset publish",
    "prepublishOnly": "pnpm clean && pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm attw",
    "prepare": "command -v simple-git-hooks >/dev/null 2>&1 && simple-git-hooks 1>&2 || true"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm phi-scan --staged"
  },
  "pnpm": {
    "overrides": {
      "esbuild@>=0.27.3 <0.28.2": "0.28.2",
      "js-yaml@>=3.0.0 <3.15.2": "3.15.2",
      "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
      "minimatch@>=7.0.0 <11.0.1": "11.0.1",
      "brace-expansion@>=3.0.0 <5.0.12": "5.0.12",
      "postcss@<8.5.23": "8.5.23",
      "source-map-js@>=1.0.0 <1.2.2": "1.2.2",
      "qs@>=6.7.0 <6.16.1": "6.16.1",
      "typedoc>minimatch": "10.2.6"
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/cli": "2.31.0",
    "@cosyte/bench": "^0.1.1",
    "@cosyte/eslint-config": "^0.1.4",
    "@cosyte/prettier-config": "^0.1.2",
    "@cosyte/process": "^0.1.8",
    "@cosyte/script-utils": "^0.1.11",
    "@cosyte/test-utils": "^0.1.4",
    "@cosyte/tsconfig": "^0.1.2",
    "@cosyte/tsup-config": "^0.1.3",
    "@cosyte/vitest-config": "^0.1.6",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/node": "^22.0.0",
    "fast-check": "4.10.2",
    "simple-git-hooks": "2.14.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "peerDependencies": {
    "fast-check": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "fast-check": {
      "optional": true
    }
  },
  "dependencies": {}
}
