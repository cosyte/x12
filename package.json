{
  "name": "@cosyte/x12",
  "version": "0.1.7",
  "description": "Developer-focused ASC X12 healthcare EDI parser, serializer, and builder for Node.js and TypeScript: lenient on parse, spec-clean on emit.",
  "license": "MIT",
  "author": "Cosyte <hello@cosyte.com> (https://cosyte.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cosyte/x12.git"
  },
  "homepage": "https://docs.cosyte.com/x12",
  "bugs": {
    "url": "https://github.com/cosyte/x12/issues"
  },
  "keywords": [
    "x12",
    "asc-x12",
    "edi",
    "healthcare",
    "hipaa",
    "5010",
    "835",
    "837",
    "270",
    "271",
    "276",
    "277",
    "278",
    "834",
    "820",
    "999",
    "remittance",
    "claims",
    "eligibility",
    "parser",
    "serializer",
    "builder",
    "typescript"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.34.5",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "KNOWN-LIMITATIONS.md",
    "LICENSE",
    "TRADEMARKS.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "prettier": "@cosyte/prettier-config",
  "scripts": {
    "build": "tsup",
    "changeset": "changeset",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"scripts/**/*.ts\" \"test/**/*.ts\" --max-warnings=0 --no-error-on-unmatched-pattern",
    "lint:fix": "eslint \"src/**/*.ts\" \"scripts/**/*.ts\" \"test/**/*.ts\" --fix --no-error-on-unmatched-pattern",
    "format": "prettier --write \"src/**/*.{ts,md}\" \"scripts/**/*.{ts,mjs}\" \"test/**/*.ts\" \"docs-content/**/*.{md,json}\" \"examples/**/*.{ts,js,json,md}\" \"*.{json,md,yml,yaml}\" --no-error-on-unmatched-pattern",
    "format:check": "prettier --check \"src/**/*.{ts,md}\" \"scripts/**/*.{ts,mjs}\" \"test/**/*.ts\" \"docs-content/**/*.{md,json}\" \"examples/**/*.{ts,js,json,md}\" \"*.{json,md,yml,yaml}\" --no-error-on-unmatched-pattern",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "fuzz": "vitest run test/property",
    "examples": "tsx scripts/run-examples.ts",
    "typecheck:examples": "tsc -p examples/tsconfig.json",
    "lint:examples": "eslint examples --max-warnings=0",
    "phi-scan:examples": "tsx scripts/phi-scan.ts examples/*.ts examples/data/*",
    "clean": "rm -rf dist coverage *.tsbuildinfo",
    "differential": "tsx scripts/differential.ts --oracle pyx12==4.0.0 --oracle linuxforhealth-x12==0.57.0 --with pydantic==1.10.13 --with python-dotenv==1.2.3 --with typing-extensions==4.16.0 --python 3.11.16",
    "differential:check": "tsx scripts/differential.ts --check",
    "phi-scan": "tsx scripts/phi-scan.ts",
    "check:no-emdash": "cosyte-no-emdash",
    "check:no-internal-refs": "cosyte-internal-refs",
    "check:readme": "cosyte-readme",
    "check:claude-card": "cosyte-claude-card",
    "check:catalog": "cosyte-catalog",
    "check:documents": "pnpm check:readme && pnpm check:claude-card && pnpm check:catalog",
    "check:release-caller-permissions": "tsx scripts/check-release-caller-permissions.ts",
    "refresh:code-lists": "tsx scripts/refresh-code-lists.ts",
    "capture:271-goldens": "tsx scripts/capture-271-goldens.ts",
    "verify:exports": "node scripts/verify-exports.mjs && node scripts/verify-exports.cjs",
    "pack:docs": "bash scripts/build-docs-artifacts.sh",
    "attw": "cosyte-attw",
    "version": "changeset version && node scripts/sync-version.mjs && tsx scripts/sync-readme-version.ts && prettier --write package.json src/index.ts README.md CHANGELOG.md",
    "release": "changeset publish",
    "prepublishOnly": "pnpm clean && pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm attw",
    "prepare": "command -v simple-git-hooks >/dev/null 2>&1 && simple-git-hooks 1>&2 || true"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm phi-scan --staged"
  },
  "pnpm": {
    "overrides": {
      "esbuild@>=0.27.3 <0.28.1": "0.28.1",
      "js-yaml@>=3.0.0 <3.15.2": "3.15.2",
      "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
      "minimatch@>=7.0.0 <11.0.1": "11.0.1",
      "brace-expansion@>=3.0.0 <5.0.12": "5.0.12",
      "postcss@<8.5.23": "8.5.23",
      "source-map-js@>=1.0.0 <1.2.2": "1.2.2"
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/cli": "2.31.0",
    "@cosyte/eslint-config": "^0.1",
    "@cosyte/prettier-config": "^0.1",
    "@cosyte/script-utils": "^0.1.7",
    "@cosyte/test-utils": "^0.1",
    "@cosyte/tsconfig": "^0.1",
    "@cosyte/tsup-config": "^0.1",
    "@cosyte/vitest-config": "^0.1",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "10.14.0",
    "fast-check": "4.10.2",
    "prettier": "3.9.10",
    "simple-git-hooks": "2.14.0",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.6",
    "vitest": "4.1.12"
  },
  "dependencies": {}
}
